# ============================================================================
# magical_ladder 全局配置
# 用法：cp config.env.example config.env 然后按需修改
# 说明：所有脚本都会读取本文件，请勿把 config.env 提交到公开仓库。
# ============================================================================

# VPS 公网 IP 或域名（客户端 Endpoint 使用）
ENDPOINT=203.0.113.1

# WireGuard 监听端口（UDP）
WG_PORT=51820

# 隧道网段（IPv4）。客户端与服务端都在此网段内。
WG_NETV4=10.8.0.0/24

# 服务端在隧道内的 IPv4 地址
SERVER_V4=10.8.0.1

# ---- IPv6（可选，留空表示仅 IPv4）----
# 仅当你的 VPS 有公网 IPv6 出口时才建议启用；否则客户端不要走 ::/0。
WG_NETV6=
SERVER_V6=

# 客户端 DNS（全隧道网关模式下建议填写，可换 223.5.5.5 / 1.1.1.1 等）
CLIENT_DNS=8.8.8.8

# 服务端出口网卡（做 MASQUERADE 的那块网卡）
PUBLIC_IFACE=eth0

# 位于 NAT 后的客户端保活间隔（秒），防止 NAT 映射过期导致“挂着就断”
KEEPALIVE=25

# 隧道 MTU：默认 1420；跨封装 / 不稳定的跨境链路可降到 1280
MTU=1420

# backup.sh / restore.sh 使用的 SSH 目标（别名或 user@host）
SSH_HOST=vps
