# macOS 命令行（wg-quick）示例配置
# 说明：把 <...> 替换为 add-client.sh 生成的真实值（或直接使用 secrets/<名字>.conf）。

[Interface]
PrivateKey = <设备私钥>
Address = 10.8.0.2/24
DNS = 8.8.8.8

[Peer]
PublicKey = <服务端公钥>
AllowedIPs = 0.0.0.0/0
Endpoint = 203.0.113.1:51820
PersistentKeepalive = 25

# 使用：
#   sudo cp 本文件 /etc/wireguard/wg0.conf
#   sudo wg-quick up wg0      # 启动
#   sudo wg-quick down wg0    # 关闭
#   sudo wg show              # 查看状态
